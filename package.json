{
  "name": "readlace",
  "description": "Read anything in your language. Readlace translates web pages, selected text and spreadsheets in place, keeping the original layout.",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11.17.0"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:store": "node --env-file-if-exists=.env scripts/store-build.mjs build",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:store": "node --env-file-if-exists=.env scripts/store-build.mjs zip",
    "compile": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --list-different --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "pnpm build && playwright test --project=chromium && playwright test --project=chromium-timing --workers=1",
    "check": "pnpm format && pnpm compile && pnpm lint:fix && pnpm test:run",
    "postinstall": "wxt prepare",
    "scan:release-secrets": "node scripts/scan-release-secrets.mjs",
    "scan:release-secrets:store": "node scripts/scan-release-secrets.mjs --store"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.42",
    "@base-ui/react": "^1.7.0",
    "ai": "^7.0.66",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tldts": "^7.4.10",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/yauzl": "^3.4.0",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.10.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "web-ext": "^10.6.0",
    "wxt": "^0.21.4",
    "yauzl": "^3.4.0"
  }
}
