# Copy this file to .env for local development.

# Extension runtime (ADR 0020: no Readlace backend; users bring their own
# provider key in the Settings page).
# Native Google Sheets Reader: off unless true. Turn on only after Google
# verifies the spreadsheets.readonly scope for this OAuth client.
# WXT_SHEETS_READER=true
# Official builds only: a plain HTTPS survey page the browser opens after the
# extension is removed (no query string; nothing identifies the user).
# WXT_UNINSTALL_SURVEY_URL=https://readlace.com/uninstall
# Optional public Web application OAuth client shared by Chrome, Comet, and Edge.
# Do not add a client secret or API key. Its authorized redirect URI is
# https://imlhpiikjakgljngkdalbfgdpkniejdb.chromiumapp.org/google-workspace
# Requests only spreadsheets.readonly; identity is an optional permission asked
# at Connect Google Workspace (ADR 0015). Store builds may omit it.
# WXT_GOOGLE_WORKSPACE_WEB_CLIENT_ID=123456789012-readlaceweb.apps.googleusercontent.com
# Optional dev-build identity: the Chrome Web Store item's public key (Developer
# Dashboard > Package > Public key, base64 without PEM lines) so an unpacked dev
# build gets the published Extension ID. Blank = committed development key.
# Store builds (pnpm build:store / zip:store) always omit the manifest key.
# WXT_EXTENSION_PUBLIC_KEY=
